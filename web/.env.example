# Copy to web/.env and fill in. Never commit web/.env.
DOMAIN=minefoot.example.com
DJANGO_ALLOWED_HOSTS=minefoot.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://minefoot.example.com
# python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"   (encrypts MFA secrets)
MINEFOOT_MFA_KEY=
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"   (signs exports; back it up)
MINEFOOT_SIGNING_KEY=
POSTGRES_DB=minefoot
POSTGRES_USER=minefoot
POSTGRES_PASSWORD=
# Optional: Copernicus Data Space S3 keys (first imagery source when set)
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
# Optional money rates for cost estimates (FR-086)
MINEFOOT_CPU_COST_PER_HOUR=0
MINEFOOT_STORAGE_COST_PER_GB_MONTH=0
